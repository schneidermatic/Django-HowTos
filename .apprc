#==============================================================================
# FILE:          .apprc
# AUTOHR:        Markus Schneider
# DATE:          2025-05-03
# PURPOSE:       App specific run command file.
#==============================================================================
APP_ENV=$HOME/.djangohw2s

if [ ! -e $APP_ENV ]
then
  cp "$CWD"/../assets/templates/djangohw2s $APP_ENV
fi

source $HOME/.djangohw2s

if [ -z $PROJECT_HOME ]
then
    echo "Please set \$PROJECT_HOME in '$APP_ENV' file!"
fi

##----------------------------------------
## MAKE A NEW HOWTO PROJECT
##----------------------------------------
app_mkhw2() {
    PROJECT_NAME=$1
    PROJECT_PATH=$PROJECT_HOME/"${PROJECT_NAME}"

    if [ ! -e "${PROJECT_PATH}" ]
    then
        mkdir -p "${PROJECT_PATH}"
        cp -r $PROJECT_HOME/assets/templates/app "${PROJECT_PATH}"
    fi
}


##----------------------------------------
## REMOVE ALL '__pycache__' FOLDERS
##----------------------------------------
app_rmpyc() {
  local start_dir="${1:-.}"
  echo "Searching for __pycache__ directories in $start_dir..."
  find "$start_dir" -type d -name "__pycache__" -exec rm -r {} + -print
  echo "All __pycache__ directories deleted."
}

##----------------------------------------
## REMOVE A HOWTO PROJECT
##----------------------------------------
app_rmhw2() {
    PROJECT_NAME=$1
    PROJECT_PATH=$PROJECT_HOME/"${PROJECT_NAME}"

    if [ -e "${PROJECT_PATH}" ]
    then
        rm -r "${PROJECT_PATH}"
    fi
}

##----------------------------------------
## SETUP THE PYTHON VENV
##----------------------------------------
app_mkvenv() {
    if [ ! -e "$CWD"/venv ]
    then
        python3 -m venv venv
        . "$CWD"/venv/bin/activate
        pip install -r requirements.txt
    fi
}

##----------------------------------------
## REMOVE VENV DIRECTORY
##----------------------------------------
app_rmvenv() {
    if [ -e "$CWD"/venv ]
    then
        rm -rf "$CWD"/venv
    fi
}

##----------------------------------------
## MAKE A NEW DJANGO PROJECT
##----------------------------------------
app_mkpro() {
    local project_name="${1:-app}"
    if [ -e "$CWD"/venv ] && [ ! -e "$CWD"/app ]
    then
        . "$CWD"/venv/bin/activate
        django-admin startproject $project_name
    fi
}

##----------------------------------------
## MAKE A NEW DJANGO PROJECT
##----------------------------------------
app_mkapp() {
    local app_name="${1:-core}"
    if [ -e "$CWD"/venv ] && [ ! -e "$CWD"/app ]
    then
        . "$CWD"/venv/bin/activate
        cd "$CWD"/app
        python manage.py startapp $app_name
        cd "$CWD"
    fi
}

##----------------------------------------
## REMOVE DJANGO PROJECT
##----------------------------------------
app_rmpro() {
    if [ -e "$CWD"/app ]
    then
        rm -rf "$CWD"/app
    fi
}

##----------------------------------------
## RUN DJANGO APP
##----------------------------------------
app_run() {
    app_setup
    cd "$CWD"/app
    python manage.py runserver
}

##----------------------------------------
## SHOW BANNER
##----------------------------------------
app_banner() {
ascii_art="  ___  _                    
 |   \\(_)__ _ _ _  __ _ ___ 
 | |) | / _\` | ' \\/ _\` / _ \\ 
 |___// \\__,_|_||_\\__, \\___/
    |__/          |___/
---------- "
echo "$ascii_art"
}  

##########################################
##########################################
#####   ---   ALL COMMANDS    ---    #####
##########################################
##########################################
app_ls() {
  app_banner
  declare -F | grep "app_" | sed -E 's/declare -f //'
}
